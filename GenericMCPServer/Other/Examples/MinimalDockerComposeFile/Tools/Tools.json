{
    "mcp-servers": [
        {
            "url-namespace": "GeneralTools",
            "anonymous": true,
            "tools": [
                {
                    "tool-name": "get_current_utc_time",
                    "type": "shell",
                    "calls": "GetCurrentUTCTime.sh",
                    "description": "Returns the current point in time in utc.",
                    "parameters": [ ]
                }
            ]
        },
        {
            "url-namespace": "Security",
            "authorized-roles": [ "security" ],
            "tools": [
                {
                    "tool-name": "get_cve_details",
                    "type": "python",
                    "calls": "GetCVEDetails.py",
                    "description": "Returns the details of a CVE (description, severity and references) from the national vulnerability database.",
                    "parameters": [ "cve-identifier" ]
                }
            ]
        },
        {
            "url-namespace": "DeveloperTools",
            "authorized-roles": [ "developer", "security" ],
            "tools": [
                {
                    "tool-name": "get_maven_versions",
                    "type": "python",
                    "calls": "GetAvailableMavenVersions.py",
                    "description": "Returns the versions of a maven-package which are available on maven-central.",
                    "parameters": [ "group-id", "artifact-id" ]
                },
                {
                    "tool-name": "get_nuget_versions",
                    "type": "python",
                    "calls": "GetAvailableNuGetVersions.py",
                    "description": "Returns the versions of a nuget-package which are available on nuget.org.",
                    "parameters": [ "package-id" ]
                },
                {
                    "tool-name": "get_pypi_versions",
                    "type": "python",
                    "calls": "GetAvailablePyPIVersions.py",
                    "description": "Returns the versions of a python-package which are available on pypi.",
                    "parameters": [ "package-name" ]
                },
                {
                    "tool-name": "get_npm_versions",
                    "type": "python",
                    "calls": "GetAvailableNPMVersions.py",
                    "description": "Returns the versions of a npm-package which are available on the npm-registry.",
                    "parameters": [ "package-name" ]
                },
                {
                    "tool-name": "get_nuget_changelog",
                    "type": "python",
                    "calls": "GetChangelogOfNuGetPackageVersion.py",
                    "description": "Returns the release-notes which one version of one nuget-package publishes.",
                    "parameters": [ "package-id", "version" ]
                },
                {
                    "tool-name": "get_pypi_changelog",
                    "type": "python",
                    "calls": "GetChangelogOfPyPIPackageVersion.py",
                    "description": "Returns where the changelog of one version of one python-package stands, together with the summary of that version. Pypi publishes no release-notes itself, so the answer states the address which the package declares as its changelog.",
                    "parameters": [ "package-name", "version" ]
                },
                {
                    "tool-name": "get_pypi_package_metadata",
                    "type": "web-request",
                    "description": "Returns the metadata which pypi publishes about a python-package. The address of the package is \"pypi.org/pypi/<package-name>/json\".",
                    "allowed-urls": [ "pypi\\.org/pypi/.*" ]
                },
                {
                    "tool-name": "research",
                    "type": "web-request",
                    "description": "Returns the content of a page of one of the usual sources of a developer (documentation, package-registries, repository-hosters and question-and-answer-sites). The address is stated without a protocol, for example \"stackoverflow.com/questions/11227809\".",
                    "allowed-urls": [
                        "angular\\.dev(/.*)?",
                        "api\\.github\\.com(/.*)?",
                        "api\\.nuget\\.org(/.*)?",
                        "bitbucket\\.org(/.*)?",
                        "central\\.sonatype\\.com(/.*)?",
                        "crates\\.io(/.*)?",
                        "datatracker\\.ietf\\.org(/.*)?",
                        "developer\\.mozilla\\.org(/.*)?",
                        "docs\\.docker\\.com(/.*)?",
                        "docs\\.python\\.org(/.*)?",
                        "git-scm\\.com(/.*)?",
                        "github\\.com(/.*)?",
                        "gitlab\\.com(/.*)?",
                        "hub\\.docker\\.com(/.*)?",
                        "json-schema\\.org(/.*)?",
                        "learn\\.microsoft\\.com(/.*)?",
                        "mcr\\.microsoft\\.com(/.*)?",
                        "nodejs\\.org(/.*)?",
                        "objects\\.githubusercontent\\.com(/.*)?",
                        "owasp\\.org(/.*)?",
                        "packagist\\.org(/.*)?",
                        "pkg\\.go\\.dev(/.*)?",
                        "pub\\.dev(/.*)?",
                        "pypi\\.org(/.*)?",
                        "quay\\.io(/.*)?",
                        "raw\\.githubusercontent\\.com(/.*)?",
                        "react\\.dev(/.*)?",
                        "registry\\.npmjs\\.org(/.*)?",
                        "repo1\\.maven\\.org(/.*)?",
                        "search\\.maven\\.org(/.*)?",
                        "semver\\.org(/.*)?",
                        "spec\\.openapis\\.org(/.*)?",
                        "stackoverflow\\.com(/.*)?",
                        "stackexchange\\.com(/.*)?",
                        "[A-Za-z0-9-]+\\.stackexchange\\.com(/.*)?",
                        "storage\\.googleapis\\.com(/.*)?",
                        "taskfile\\.dev(/.*)?",
                        "typescriptlang\\.org(/.*)?",
                        "www\\.npmjs\\.com(/.*)?",
                        "www\\.nuget\\.org(/.*)?",
                        "www\\.oracle\\.com(/.*)?",
                        "oracle\\.com(/.*)?",
                        "www\\.google\\.com(/.*)?",
                        "google\\.com(/.*)?"
                    ]
                }
            ]
        }
    ]
}
